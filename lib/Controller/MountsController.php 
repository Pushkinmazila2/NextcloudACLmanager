<?php

declare(strict_types=1);

namespace OCA\NcAclManager\Controller;

use OCA\NcAclManager\AppInfo\Application;
use OCP\AppFramework\Controller;
use OCP\AppFramework\Http\Attribute\NoAdminRequired;
use OCP\AppFramework\Http\JSONResponse;
use OCP\IConfig;
use OCP\IRequest;

/**
 * Маппинги NC пути → UNC путь Windows шары.
 *
 * Когда пользователь открывает папку через внешнее хранилище SMB,
 * NC показывает путь вида /имя_точки_монтирования/подпапка
 * Агент ожидает \\SERVER\Share\подпапка
 *
 * Администратор настраивает эти маппинги в плагине.
 */
class MountsController extends Controller
{
    public function __construct(
        string                   $appName,
        IRequest                 $request,
        private readonly IConfig $config,
    ) {
        parent::__construct($appName, $request);
    }

    /**
     * GET /api/mounts — список маппингов для JS
     */
    #[NoAdminRequired]
    public function index(): JSONResponse
    {
        $raw    = $this->config->getAppValue(Application::APP_ID, 'path_mappings', '[]');
        $mounts = json_decode($raw, true) ?? [];

        return new JSONResponse(['mounts' => $mounts]);
    }

    /**
     * GET /api/mounts/admin — список с деталями (только admin)
     */
    public function adminIndex(): JSONResponse
    {
        $raw    = $this->config->getAppValue(Application::APP_ID, 'path_mappings', '[]');
        $mounts = json_decode($raw, true) ?? [];

        return new JSONResponse(['mounts' => $mounts]);
    }

    /**
     * POST /api/mounts — сохранить список маппингов
     */
    public function save(array $mounts): JSONResponse
    {
        // Валидируем каждый маппинг
        $valid = [];
        foreach ($mounts as $m) {
            $ncPath  = trim($m['ncPath']  ?? '');
            $uncPath = trim($m['uncPath'] ?? '');

            if (empty($ncPath) || empty($uncPath)) continue;

            // NC путь должен начинаться с /
            if (!str_starts_with($ncPath, '/')) {
                $ncPath = '/' . $ncPath;
            }

            // UNC путь должен начинаться с \\ или //
            if (!str_starts_with($uncPath, '\\\\') && !str_starts_with($uncPath, '//')) {
                return new JSONResponse(
                    ['error' => "UNC путь должен начинаться с \\\\ : {$uncPath}"],
                    400
                );
            }

            $valid[] = [
                'ncPath'      => rtrim($ncPath, '/'),
                'uncPath'     => rtrim($uncPath, '\\/ '),
                'description' => trim($m['description'] ?? ''),
            ];
        }

        $this->config->setAppValue(
            Application::APP_ID,
            'path_mappings',
            json_encode($valid, JSON_UNESCAPED_UNICODE)
        );

        return new JSONResponse(['success' => true, 'count' => count($valid)]);
    }
}